# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database (Neon) -------------------------------------------------------
# From the Neon dashboard, "Connection string" -> Java. Note Neon requires SSL.
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/docuvault?sslmode=require
DB_USERNAME=docuvault_owner
DB_PASSWORD=

# Neon's free tier bills by compute-hour, so keep the pool small and let it
# drop to zero idle connections between requests.
DB_POOL_MAX=5
DB_POOL_MIN=0

# --- JWT -------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
# The app refuses to start if this is missing or shorter than 32 bytes.
JWT_SECRET=
JWT_TTL=PT1H

# --- CORS ------------------------------------------------------------------
# Your Netlify site, comma-separated if more than one.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-site.netlify.app

# --- File storage ----------------------------------------------------------
# local = a directory on disk (development only; a PaaS wipes it on restart)
# s3    = any S3-compatible bucket: Cloudflare R2, Supabase Storage, MinIO, AWS
STORAGE_TYPE=local
STORAGE_DIR=./storage

# Only needed when STORAGE_TYPE=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Misc ------------------------------------------------------------------
MAX_FILE_SIZE=25MB
LOG_LEVEL=INFO
